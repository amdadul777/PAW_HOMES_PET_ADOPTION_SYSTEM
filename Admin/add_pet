<?php
require_once '../config.php';
require_once 'auth_guard.php';

$message = '';
$error   = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $name        = trim($_POST['name']);
    $species     = trim($_POST['species']);
    $breed       = trim($_POST['breed']);
    $age         = trim($_POST['age']);
    $gender      = $_POST['gender'];
    $description = trim($_POST['description']);
    $image_url   = trim($_POST['image_url']);

    if (!$name || !$species || !$gender) {
        $error = "Name, Species, and Gender are required.";
    } else {
        if (empty($image_url)) {
            $image_url = 'https://via.placeholder.com/300x200?text=No+Image';
        }
        $stmt = $pdo->prepare("INSERT INTO pets (name, species, breed, age, gender, description, image_url) VALUES (?, ?, ?, ?, ?, ?, ?)");
        $stmt->execute([$name, $species, $breed, $age, $gender, $description, $image_url]);
        $message = "Pet added successfully! <a href='pets.php'>View all pets</a>";
    }
}
