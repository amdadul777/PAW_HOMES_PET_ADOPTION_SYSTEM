<?php
require_once '../config.php';
require_once 'auth_guard.php';

$message = '';

// Handle delete user
if (isset($_GET['delete'])) {
    $del_id = (int)$_GET['delete'];
    // Delete user's adoption requests first
    $pdo->prepare("DELETE FROM adoptions WHERE user_id = ?")->execute([$del_id]);
    $pdo->prepare("DELETE FROM users WHERE id = ?")->execute([$del_id]);
    $message = "User deleted successfully.";
}

$users = $pdo->query("
    SELECT u.*, COUNT(a.id) AS total_requests
    FROM users u
    LEFT JOIN adoptions a ON u.id = a.user_id
    GROUP BY u.id
    ORDER BY u.created_at DESC
")->fetchAll(PDO::FETCH_ASSOC);
?>
