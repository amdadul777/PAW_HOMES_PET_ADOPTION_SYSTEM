<?php
require_once '../config.php';
require_once 'auth_guard.php';

$message = '';

// Handle approve / reject
if (isset($_GET['action']) && isset($_GET['id'])) {
    $req_id = (int)$_GET['id'];
    $action = $_GET['action'];

    if ($action === 'approve') {
        // Get pet_id for this request
        $row = $pdo->prepare("SELECT pet_id FROM adoptions WHERE id = ?");
        $row->execute([$req_id]);
        $adoption = $row->fetch(PDO::FETCH_ASSOC);

        if ($adoption) {
            // Approve this request
            $pdo->prepare("UPDATE adoptions SET status = 'Approved' WHERE id = ?")->execute([$req_id]);
            // Mark pet as adopted
            $pdo->prepare("UPDATE pets SET status = 'Adopted' WHERE id = ?")->execute([$adoption['pet_id']]);
            // Reject all other requests for same pet
            $pdo->prepare("UPDATE adoptions SET status = 'Rejected' WHERE pet_id = ? AND id != ?")->execute([$adoption['pet_id'], $req_id]);
            $message = "Adoption approved! Pet has been marked as adopted.";
        }
    } elseif ($action === 'reject') {
        $pdo->prepare("UPDATE adoptions SET status = 'Rejected' WHERE id = ?")->execute([$req_id]);
        // If no approved request exists for this pet, set pet back to available
        $row = $pdo->prepare("SELECT pet_id FROM adoptions WHERE id = ?");
        $row->execute([$req_id]);
        $adoption = $row->fetch(PDO::FETCH_ASSOC);
        if ($adoption) {
            $approved = $pdo->prepare("SELECT id FROM adoptions WHERE pet_id = ? AND status = 'Approved'");
            $approved->execute([$adoption['pet_id']]);
            if (!$approved->fetch()) {
                $pdo->prepare("UPDATE pets SET status = 'Available' WHERE id = ? AND status = 'Pending'")->execute([$adoption['pet_id']]);
            }
        }
        $message = "Adoption request rejected.";
    }
}

$filter = isset($_GET['filter']) ? $_GET['filter'] : '';
$sql = "
    SELECT a.*, u.name AS user_name, u.email AS user_email, u.phone AS user_phone,
           p.name AS pet_name, p.species
    FROM adoptions a
    JOIN users u ON a.user_id = u.id
    JOIN pets p ON a.pet_id = p.id
";
$params = [];
if (in_array($filter, ['Pending','Approved','Rejected'])) {
    $sql .= " WHERE a.status = ?";
    $params[] = $filter;
}
$sql .= " ORDER BY a.created_at DESC";

$stmt = $pdo->prepare($sql);
$stmt->execute($params);
$adoptions = $stmt->fetchAll(PDO::FETCH_ASSOC);
?>
