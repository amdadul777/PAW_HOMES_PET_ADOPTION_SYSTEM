require_once 'auth_guard.php';

$total_pets    = $pdo->query("SELECT COUNT(*) FROM pets")->fetchColumn();
$available     = $pdo->query("SELECT COUNT(*) FROM pets WHERE status='Available'")->fetchColumn();
$adopted       = $pdo->query("SELECT COUNT(*) FROM pets WHERE status='Adopted'")->fetchColumn();
$total_users   = $pdo->query("SELECT COUNT(*) FROM users")->fetchColumn();
$total_requests= $pdo->query("SELECT COUNT(*) FROM adoptions")->fetchColumn();
$pending_req   = $pdo->query("SELECT COUNT(*) FROM adoptions WHERE status='Pending'")->fetchColumn();

// Recent adoption requests
$recent = $pdo->query("
    SELECT a.*, u.name AS user_name, p.name AS pet_name
    FROM adoptions a
    JOIN users u ON a.user_id = u.id
    JOIN pets p ON a.pet_id = p.id
    ORDER BY a.created_at DESC
    LIMIT 5
")->fetchAll(PDO::FETCH_ASSOC);
?>
