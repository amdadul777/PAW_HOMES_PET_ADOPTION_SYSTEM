<?php
require_once '../config.php';
require_once 'auth_guard.php';

$id = isset($_GET['id']) ? (int)$_GET['id'] : 0;
if (!$id) { header('Location: pets.php'); exit; }

$stmt = $pdo->prepare("SELECT * FROM pets WHERE id = ?");
$stmt->execute([$id]);
$pet = $stmt->fetch(PDO::FETCH_ASSOC);
if (!$pet) { echo "Pet not found."; exit; }

$message = '';
$error   = '';

if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $name        = trim($_POST['name']);
    $species     = trim($_POST['species']);
    $breed       = trim($_POST['breed']);
    $age         = trim($_POST['age']);
    $gender      = $_POST['gender'];
    $description = trim($_POST['description']);
    $image_url   = trim($_POST['image_url']);
    $status      = $_POST['status'];

    if (!$name || !$species || !$gender) {
        $error = "Name, Species, and Gender are required.";
    } else {
        if (empty($image_url)) {
            $image_url = $pet['image_url'];
        }
        $upd = $pdo->prepare("UPDATE pets SET name=?, species=?, breed=?, age=?, gender=?, description=?, image_url=?, status=? WHERE id=?");
        $upd->execute([$name, $species, $breed, $age, $gender, $description, $image_url, $status, $id]);
        $message = "Pet updated successfully.";
        // Refresh pet data
        $stmt->execute([$id]);
        $pet = $stmt->fetch(PDO::FETCH_ASSOC);
    }
}
