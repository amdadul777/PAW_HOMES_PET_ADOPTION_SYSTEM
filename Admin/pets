<?php
require_once '../config.php';
require_once 'auth_guard.php';

$message = '';
$error = '';

// Handle delete
if (isset($_GET['delete'])) {
    $del_id = (int)$_GET['delete'];
    // Remove adoption requests first
    $pdo->prepare("DELETE FROM adoptions WHERE pet_id = ?")->execute([$del_id]);
    $pdo->prepare("DELETE FROM pets WHERE id = ?")->execute([$del_id]);
    $message = "Pet deleted successfully.";
}

// Handle status update
if (isset($_GET['status']) && isset($_GET['id'])) {
    $new_status = $_GET['status'];
    $upd_id = (int)$_GET['id'];
    if (in_array($new_status, ['Available', 'Adopted', 'Pending'])) {
        $pdo->prepare("UPDATE pets SET status = ? WHERE id = ?")->execute([$new_status, $upd_id]);
        $message = "Pet status updated.";
    }
}

$pets = $pdo->query("SELECT * FROM pets ORDER BY created_at DESC")->fetchAll(PDO::FETCH_ASSOC);
