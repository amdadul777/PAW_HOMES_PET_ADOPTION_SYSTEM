<?php
require_once 'config.php';

$id = isset($_GET['id']) ? (int)$_GET['id'] : 0;
if (!$id) { header('Location: pets.php'); exit; }

$stmt = $pdo->prepare("SELECT * FROM pets WHERE id = ?");
$stmt->execute([$id]);
$pet = $stmt->fetch(PDO::FETCH_ASSOC);

if (!$pet) { echo "Pet not found."; exit; }

$message = '';
$error = '';

// Handle adoption request
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    if (!isset($_SESSION['user_id'])) {
        header('Location: login.php?redirect=pet_detail.php?id=' . $id);
        exit;
    }

    // Check if user already requested this pet
    $check = $pdo->prepare("SELECT id FROM adoptions WHERE user_id = ? AND pet_id = ?");
    $check->execute([$_SESSION['user_id'], $id]);
    if ($check->fetch()) {
        $error = "You have already submitted an adoption request for this pet.";
    } elseif ($pet['status'] !== 'Available') {
        $error = "This pet is no longer available for adoption.";
    } else {
        $msg = trim($_POST['message']);
        $stmt2 = $pdo->prepare("INSERT INTO adoptions (user_id, pet_id, message) VALUES (?, ?, ?)");
        $stmt2->execute([$_SESSION['user_id'], $id, $msg]);

        // Update pet status to Pending
        $pdo->prepare("UPDATE pets SET status = 'Pending' WHERE id = ?")->execute([$id]);
        $pet['status'] = 'Pending';
        $message = "Your adoption request has been submitted! We will contact you soon.";
    }
}
