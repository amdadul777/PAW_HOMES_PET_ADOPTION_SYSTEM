                    <th>Request Status</th>
                    <th>Date Submitted</th>
                    <th>Message</th>
                </tr>
            </thead>
            <tbody>
                <?php foreach ($requests as $r): ?>
                <tr>
                    <td>
                        <img src="<?= htmlspecialchars($r['image_url']) ?>" style="width:50px;height:40px;object-fit:cover;border-radius:4px;" onerror="this.style.display='none'">
