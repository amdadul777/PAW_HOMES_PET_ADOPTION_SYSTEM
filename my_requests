    <?php if (empty($requests)): ?>
        <div class="alert alert-info">You haven't submitted any adoption requests yet. <a href="pets.php">Browse pets</a></div>
    <?php else: ?>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Pet</th>
