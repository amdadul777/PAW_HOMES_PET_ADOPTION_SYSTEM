                    </td>
                    <td><?= htmlspecialchars($r['species']) ?></td>
                    <td><?= htmlspecialchars($r['breed']) ?></td>
                    <td><span class="badge <?= strtolower($r['status']) ?>"><?= $r['status'] ?></span></td>
                    <td><?= date('d M Y', strtotime($r['created_at'])) ?></td>
                    <td><?= htmlspecialchars(substr($r['message'], 0, 60)) ?><?= strlen($r['message']) > 60 ? '...' : '' ?></td>
                </tr>
                <?php endforeach; ?>
